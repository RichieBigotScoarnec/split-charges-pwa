{
  "name": "split-charges-pwa",
  "version": "4.0.0",
  "description": "Répartition des charges d'un foyer au prorata des salaires nets (PWA, Firebase)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "npx playwright test",
    "test:all": "vitest run && npm run test:e2e",
    "emulators": "npx firebase emulators:start",
    "emulators:test": "npx firebase emulators:exec \"npx playwright test tests/e2e/firebase-integration.spec.js\"",
    "icones": "node tools/generer-icones.mjs",
    "serve": "npx http-server public -p 3333 -c-1",
    "deploy:rules": "npx firebase deploy --only database --project fairsplit-foyer",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "eslint . --quiet && vitest run",
    "deploy:hosting": "npx firebase deploy --only hosting --project fairsplit-foyer",
    "couverture": "npm run couverture:unitaire && npm run couverture:e2e && npm run couverture:fusion",
    "couverture:unitaire": "vitest run --coverage --coverage.reporter=json --coverage.include=\"public/js/**\"",
    "couverture:e2e": "COUVERTURE=1 npx firebase emulators:exec --only auth,database \"npx playwright test\"",
    "couverture:fusion": "node tools/fusionner-couverture.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichieBigotScoarnec/split-charges-pwa.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RichieBigotScoarnec/split-charges-pwa/issues"
  },
  "homepage": "https://github.com/RichieBigotScoarnec/split-charges-pwa#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "firebase-tools": "^15.11.0",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "sharp": "0.35.3",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
